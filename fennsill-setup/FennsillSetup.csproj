<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FennsillSetup</AssemblyName>
    <Version>0.1.23</Version>
    <Product>FennSill</Product>
    <Company>FennSill</Company>
    <ApplicationIcon>..\fennsill-desk\fennsill.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Condition="Exists('quickstart\FennSill-Quick-Start.pdf')">
    <Content Include="quickstart\FennSill-Quick-Start.pdf" Link="payload\FennSill-Quick-Start.pdf" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Staged by publish_release.ps1 into setup-payload\ before publishing Setup. -->
  <ItemGroup Condition="Exists('setup-payload\Fennsill.exe')">
    <Content Include="setup-payload\**\*" Link="payload\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
