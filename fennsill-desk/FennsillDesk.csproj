<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FennsillDesk</AssemblyName>
    <Version>0.1.28</Version>
    <Product>FennSill</Product>
    <Company>FennSill</Company>
    <ApplicationIcon>fennsill.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Bundled payload so a lone Fennsill.exe download can self-install.
       Top-level connector/*.py must be listed — runtime/** alone misses push_page.py
       (claimed cloud jobs then crash: No module named push_page). -->
  <ItemGroup>
    <Content Include="..\connector\*.py" Link="payload\connector\%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\connector\runtime\**\*" Link="payload\connector\runtime\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\connector\prompts\**\*" Link="payload\connector\prompts\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\connector\requirements.txt" Link="payload\connector\requirements.txt" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\firmware\**\*" Link="payload\firmware\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\templates\**\*" Link="payload\templates\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="..\firmware\**\__pycache__\**" />
    <Content Remove="..\connector\runtime\**\__pycache__\**" />
    <Content Remove="..\templates\**\__pycache__\**" />
    <Content Remove="..\connector\_debug_*.py" />
  </ItemGroup>

</Project>
