# Fennsill cloud + SQL Server (placeholders only — never commit real secrets)

# Prefer SQL Server when set. If unset, cloud may keep using SQLite until cutover.
FENNSILL_SQL_CONNECTION=Driver={ODBC Driver 18 for SQL Server};Server=tcp:YOUR_HOST,1433;Database=fennsill;Uid=fennsill_app;Pwd=CHANGE_ME;Encrypt=yes;TrustServerCertificate=no;

# Legacy SQLite path (live today). Keep for rollback until cutover is explicit.
# FENNSILL_CLOUD_DB=/data/cloud.db

# Public URLs (TLS reverse proxy in front of the container)
FENNSILL_PUBLIC_URL=https://mcp.fennsill.com
FENNSILL_PUBLIC_MCP_URL=https://mcp.fennsill.com/mcp

# Cloud listen bind (inside Docker / Unraid)
FENNSILL_CLOUD_HOST=0.0.0.0
FENNSILL_CLOUD_PORT=8080

# Factory inventory upload / import API (server-side check)
# Header: Authorization: Bearer <token>  OR  X-Fennsill-Factory-Token: <token>
FENNSILL_FACTORY_IMPORT_TOKEN=CHANGE_ME_LONG_RANDOM

# Optional: account-web proxy (if run separately from cloud container)
# FENNSILL_API_BASE=https://mcp.fennsill.com
# FENNSILL_ACCOUNT_HOST=0.0.0.0
# FENNSILL_ACCOUNT_PORT=8090

# Subscription period (days). Product decision: 60.
FENNSILL_TRIAL_DAYS=60

# Session lifetime for user bearer (optional hardening)
# FENNSILL_SESSION_DAYS=90
